# ===== LLM 配置（至少配置一个 Key）=====
# openai / deepseek / qwen
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
QWEN_API_KEY=

# ===== 高德地图（景点 / 酒店 / 路线规划）=====
# 申请：https://console.amap.com/dev/key/app
# 注意：必须选「Web 服务」类型的 Key，否则会报 USERKEY_PLAT_NOMATCH(10009)
AMAP_API_KEY=
AMAP_BASE_URL=https://restapi.amap.com/v3
AMAP_TIMEOUT=15
# 同 Key 全局串行限速（秒/请求），避免 Agent 并行调用时触发 10021 QPS 超限
AMAP_MIN_INTERVAL=0.34
# 命中 QPS 限流时的重试次数（指数退避）
AMAP_QPS_RETRY=2

# ===== 博查 AI 搜索（景点 / 必玩地点 / 酒店搜索）=====
# 申请：https://open.bochaai.com
BOCHA_API_KEY=
BOCHA_BASE_URL=https://api.bochaai.com
BOCHA_SEARCH_PATH=/v1/web-search
# 是否返回网页正文摘要（summary）
BOCHA_SUMMARY=true
# 单次返回条数，博查上限 50
BOCHA_COUNT=8
# 时间范围：noLimit / oneDay / oneWeek / oneMonth / oneYear
BOCHA_FRESHNESS=noLimit
# 酒店价格与口碑时效性强，限定一年内
BOCHA_HOTEL_FRESHNESS=oneYear
BOCHA_TIMEOUT=30

# ===== 线上模式 =====
# 严格线上：缺 Key / 调用失败直接报明确错误，绝不返回模拟数据
STRICT_ONLINE=true

# ===== Docker 部署配置 =====
POSTGRES_PASSWORD=postgres
SECRET_KEY=your-secret-key-change-in-production
